{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Control": {
      "properties": {
        "id": {
          "type": "string"
        },
        "refCode": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "subcategory": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mappedControls": {
          "$ref": "#/$defs/MappedControls"
