          "type": "string"
        },
        "refCode": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "subcategory": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mappedControls": {
          "$ref": "#/$defs/MappedControls"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "refCode"
      ]
    }
  },
  "items": {
    "$ref": "#/$defs/Control"
  },
  "type": "array"
}
