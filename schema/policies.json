{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Policy": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "policyType": {
          "type": "string"
        },
        "markdownPath": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mappedControls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    }
  },
  "items": {
    "$ref": "#/$defs/Policy"
  },
  "type": "array"
}
